{
    "name": "xeven",
    "version": "1.0.0",
    "description": "XEVEN \u2014 configurable multi-tenant AI agent platform for businesses",
    "main": "server/index.js",
    "private": true,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "start": "node server/index.js",
        "dev": "node --watch server/index.js",
        "migrate": "node -e \"require('./server/src/db').init(); console.log('Migrations applied.')\"",
        "test": "node --test \"tests/*.test.js\"",
        "test:concurrency1": "node --test --test-concurrency=1 \"tests/*.test.js\"",
        "setup": "node scripts/setup.js",
        "setup:echo": "pip install -r echo/requirements.txt && echo \"Echo deps installed \u2014 set ECHO_SIDECAR_URL=http://127.0.0.1:8765\"",
        "roles:generate": "node scripts/generate-roles.js"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "node-cron": "^4.6.0",
        "nodemailer": "^9.0.5",
        "pg": "^8.23.0",
        "ws": "^8.18.0"
    }
}
