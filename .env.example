# ============================================================
# NOVA — environment configuration
# Copy to .env and adjust. Business-specific settings do NOT
# belong here; they live in each business's configuration
# (admin dashboard or /api/v1/config).
# ============================================================

# --- runtime -------------------------------------------------
NODE_ENV=development            # development | staging | production
PORT=3000

# --- database ------------------------------------------------
# SQLite file. Migrations run automatically on startup.
NOVA_DB_PATH=./database/nova.db

# --- AI provider ---------------------------------------------
# ollama | openai-compatible | mock
AI_PROVIDER=ollama
NOVA_MODEL=qwen2.5-coder:3b
OLLAMA_URL=http://127.0.0.1:11434

# Used when AI_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

NOVA_AI_TIMEOUT_MS=120000
NOVA_AI_TEMPERATURE=0.7

# --- CORS ------------------------------------------------------
# true = reflect any origin (widgets can embed anywhere).
# Or set an explicit origin list entry.
NOVA_CORS_ORIGIN=true

# --- security ---------------------------------------------------
# HMAC secret for admin dashboard tokens. If empty, a strong
# secret is generated once and stored in the database.
NOVA_ADMIN_TOKEN_SECRET=
NOVA_ADMIN_TOKEN_TTL_SEC=43200

# Rate limiting (per business key / per IP)
NOVA_RATE_WINDOW_MS=60000
NOVA_RATE_LIMIT=120
NOVA_MAX_BODY_BYTES=1000000

# --- chrono / echo (copied from nova-chrono + nova-echo, now first-party) ---
# Local: runs faster-whisper sidecar on 8765 (no key needed). 
# Vercel/prod: sidecar not available — set OPENAI_API_KEY and leave ECHO_SIDECAR_URL empty to use OpenAI Whisper/TTS (parity with local).
# To force-disable sidecar on Vercel, leave ECHO_SIDECAR_URL empty (default when VERCEL env is set).
ECHO_SIDECAR_URL=http://127.0.0.1:8765   # local sidecar; on Vercel set to empty + set OPENAI_API_KEY for parity
# ECHO_MODEL=turbo                         # tiny|base|small|medium|large|turbo
# On Vercel, set OPENAI_API_KEY (sk-...) for server STT/TTS parity with local sidecar. Without it, widget falls back to browser STT/TTS.

# --- observability ------------------------------------------------
NOVA_LOG_LEVEL=info           # debug | info | warn | error
